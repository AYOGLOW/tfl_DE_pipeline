{
  "datasets": [
    {
      "name": "hourly_patterns",
      "displayName": "Hourly Arrival Patterns",
      "queryLines": [
        "SELECT\n",
        "  line_name,\n",
        "  hour_of_day,\n",
        "  day_of_week,\n",
        "  arrival_count,\n",
        "  avg_wait_time_seconds,\n",
        "  avg_wait_time_minutes,\n",
        "  ingest_date\n",
        "FROM\n",
        "  tfl.gold.hourly_patterns_gd\n",
        "WHERE\n",
        "  ingest_date = '2026-02-07'"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "station_activity",
      "displayName": "Station Activity",
      "queryLines": [
        "SELECT\n",
        "  station_name,\n",
        "  naptan_id,\n",
        "  data_source,\n",
        "  total_arrivals,\n",
        "  distinct_lines_serving,\n",
        "  avg_wait_time_seconds,\n",
        "  avg_wait_time_minutes,\n",
        "  ingest_date\n",
        "FROM\n",
        "  tfl.gold.station_activity_gd\n",
        "WHERE\n",
        "  ingest_date = '2026-02-07'"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "line_performance",
      "displayName": "Line Performance Metrics",
      "queryLines": [
        "SELECT\n",
        "  line_name,\n",
        "  line_id,\n",
        "  mode_name,\n",
        "  total_predictions,\n",
        "  avg_wait_time_seconds,\n",
        "  min_wait_time_seconds,\n",
        "  max_wait_time_seconds,\n",
        "  stddev_wait_time_seconds,\n",
        "  active_vehicles,\n",
        "  avg_wait_time_minutes,\n",
        "  ingest_date\n",
        "FROM\n",
        "  tfl.gold.line_performance_gd\n",
        "WHERE\n",
        "  ingest_date = '2026-02-07'"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "status_history",
      "displayName": "Service Status History",
      "queryLines": [
        "SELECT\n",
        "  line_name,\n",
        "  line_id,\n",
        "  mode_name,\n",
        "  status_severity,\n",
        "  status_description,\n",
        "  ingest_date,\n",
        "  status_snapshot_count,\n",
        "  first_observed,\n",
        "  last_observed\n",
        "FROM\n",
        "  tfl.gold.status_history_gd\n",
        "WHERE\n",
        "  ingest_date = '2026-02-07'"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "export_full_snapshot",
      "displayName": "Export Data - Full Snapshot",
      "queryLines": [
        "SELECT\n",
        "  p.line_name,\n",
        "  p.mode_name,\n",
        "  s.status_description,\n",
        "  s.status_severity,\n",
        "  p.total_predictions as total_arrivals,\n",
        "  p.avg_wait_time_minutes,\n",
        "  p.min_wait_time_seconds / 60.0 as min_wait_minutes,\n",
        "  p.max_wait_time_seconds / 60.0 as max_wait_minutes,\n",
        "  p.active_vehicles,\n",
        "  p.ingest_date,\n",
        "  s.first_observed,\n",
        "  s.last_observed\n",
        "FROM\n",
        "  tfl.gold.line_performance_gd p\n",
        "    INNER JOIN tfl.gold.status_history_gd s\n",
        "      ON p.line_name = s.line_name\n",
        "      AND p.ingest_date = s.ingest_date\n",
        "WHERE\n",
        "  p.ingest_date = '2026-02-07'\n",
        "ORDER BY\n",
        "  p.line_name"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "disruption_details",
      "displayName": "Service Disruption Details",
      "queryLines": [
        "SELECT\n",
        "  line_name,\n",
        "  mode_name,\n",
        "  status_description,\n",
        "  status_severity,\n",
        "  first_observed,\n",
        "  last_observed\n",
        "FROM\n",
        "  tfl.gold.status_history_gd\n",
        "WHERE\n",
        "  ingest_date = '2026-02-07'\n",
        "ORDER BY\n",
        "  status_severity DESC,\n",
        "  line_name"
      ],
      "catalog": "tfl",
      "schema": "gold"
    },
    {
      "name": "alerts",
      "displayName": "Active Alerts",
      "queryLines": [
        "SELECT\n",
        "  p.line_name,\n",
        "  p.mode_name,\n",
        "  s.status_description,\n",
        "  s.status_severity,\n",
        "  p.avg_wait_time_minutes,\n",
        "  p.active_vehicles,\n",
        "  p.total_predictions as total_arrivals,\n",
        "  CASE\n",
        "    WHEN s.status_severity < 10 THEN 'Service Disruption'\n",
        "    WHEN p.avg_wait_time_minutes > 25 THEN 'Excessive Wait Time'\n",
        "    ELSE 'Other'\n",
        "  END as alert_type,\n",
        "  CASE\n",
        "    WHEN s.status_severity < 10 THEN 'High'\n",
        "    WHEN p.avg_wait_time_minutes > 25 THEN 'Medium'\n",
        "    ELSE 'Low'\n",
        "  END as alert_priority,\n",
        "  s.first_observed\n",
        "FROM\n",
        "  tfl.gold.line_performance_gd p\n",
        "    INNER JOIN tfl.gold.status_history_gd s\n",
        "      ON p.line_name = s.line_name\n",
        "      AND p.ingest_date = s.ingest_date\n",
        "WHERE\n",
        "  p.ingest_date = '2026-02-07'\n",
        "  AND (\n",
        "    s.status_severity < 10\n",
        "    OR p.avg_wait_time_minutes > 25\n",
        "  )\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN s.status_severity < 10 THEN 1\n",
        "    WHEN p.avg_wait_time_minutes > 25 THEN 2\n",
        "    ELSE 3\n",
        "  END,\n",
        "  p.avg_wait_time_minutes DESC"
      ]
    }
  ],
